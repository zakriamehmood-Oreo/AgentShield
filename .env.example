# Copy this file to .env and fill in real values. NEVER commit .env.
# See docs/ for full explanations of each setting.

# ---- OpenAI (hosted, no GPU required) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EVAL_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Pinecone (serverless) ----
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=agentshield-policies
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- PostgreSQL ----
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentshield
# This default (@db:5432/...) is the Docker-network value. For running
# things directly on the host (e.g. `uv run python scripts/seed.py` outside
# Docker), override it to use localhost:${DB_PORT:-5433} instead.
DATABASE_URL=postgresql+psycopg://agentshield:change-me@db:5432/agentshield

# ---- App / API ----
APP_ENV=development
SECRET_KEY=change-me-to-a-random-value
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Host-side value for local dev without Docker; inside Docker, compose
# already overrides this to http://tool_server:9000/mcp.
TOOL_SERVER_URL=http://localhost:9000/mcp

# ---- Cost & safety controls ----
MOCK_MODE=true
MAX_MODEL_CALLS_PER_RUN=50
MAX_CONCURRENCY=4
TOKEN_BUDGET_USD_PER_RUN=1.00
AGENT_MAX_STEPS=8
RESPONSE_CACHE_ENABLED=true
DATASET_SAMPLE_SIZE=

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Tracing (OpenTelemetry-compatible; leave blank to log locally only) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentshield
